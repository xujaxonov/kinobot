# @BotFather bergan token
BOT_TOKEN=123456:ABC-DEF...
# Adminlar Telegram ID lari (vergul bilan). ID ni bilish uchun botga /id yozing
ADMIN_IDS=111111111,222222222
# Kinolar saqlanadigan yopiq kanal ID si (-100 bilan boshlanadi)
STORAGE_CHANNEL_ID=-1001234567890
# Railway PostgreSQL avtomatik beradi
DATABASE_URL=postgresql://user:pass@host:5432/railway
# Click / Payme (ixtiyoriy): @BotFather -> bot -> Payments -> provayder tokeni
# Bo'sh qoldirilsa, shu to'lov usuli tugmasi chiqmaydi
CLICK_PROVIDER_TOKEN=
PAYME_PROVIDER_TOKEN=
